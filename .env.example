# DocuVista 环境变量配置（示例）
# 复制此文件为 .env，然后填入真实凭证

# ========== LLM 配置（豆包/火山引擎 ARK）==========
LLM_API_KEY=你的ARK_API_KEY

# ========== 百度 OCR 配置 ==========
BAIDU_OCR_API_KEY=你的百度OCR_API_KEY
BAIDU_OCR_SECRET_KEY=你的百度OCR_SECRET_KEY

# ========== 腾讯 OCR 配置（可选）==========
# TENCENT_SECRET_ID=你的腾讯SECRET_ID
# TENCENT_SECRET_KEY=你的腾讯SECRET_KEY

# ========== 管理员凭证 ==========
SUPER_ADMIN_PASSWORD=你的管理员密码
